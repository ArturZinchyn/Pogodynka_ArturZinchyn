{% extends 'base.html.twig' %}

{% block title %}Measurement index{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Measurement index</h1>
        <a href="{{ path('app_measurement_new') }}" class="btn btn-primary">Create new</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead>
        <tr>
            <th>Id</th>
            <th>Location</th>
            <th>Date</th>
            <th>Temperature</th>
            <th>Precipitation</th>
            <th>Humidity</th>
            <th>Pressure</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for measurement in measurements %}
            <tr>
                <td>{{ measurement.id }}</td>
                <td>{{ measurement.location ? measurement.location.name : '' }}</td>
                <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                <td>{{ measurement.temperature }} °C</td>
                <td>{{ measurement.precipitation }} mm</td>
                <td>{{ measurement.humidity }} %</td>
                <td>{{ measurement.pressure }} hPa</td>
                <td>
                    <a href="{{ path('app_measurement_show', {'id': measurement.id}) }}" class="btn btn-sm btn-outline-secondary">show</a>
                    <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}" class="btn btn-sm btn-outline-primary">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center text-muted">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
